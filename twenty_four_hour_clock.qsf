# DE2-115 24-hour clock - Cyclone IV E EP4CE115F29C7
# Assumes JP7 = 2.5 V (pins 5-6 shorted) and JP6 = 3.3 V (pins 7-8 shorted).
# Verify jumper positions before programming.
# Sources: Terasic DE2-115 User Manual, Tables 4-1 through 4-5, 4-8, 4-11.

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY twenty_four_hour_clock
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 21.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "18:10:28  MAI 08, 2024"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name BDF_FILE twenty_four_hour_clock_schematic.bdf
set_global_assignment -name VHDL_FILE twenty_four_hour_clock_tb.vhd
set_global_assignment -name VHDL_FILE twenty_four_hour_clock.vhd
set_global_assignment -name VHDL_FILE bcd_counter.vhd
set_global_assignment -name VHDL_FILE bcd_to_segment_encoder.vhd
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name SDC_FILE twenty_four_hour_clock.sdc

# No LogicLock partitioning is needed in this simple design.
# If the old project uses partitions intentionally, retain its partition settings.

# 50 MHz oscillator
set_location_assignment PIN_Y2 -to clk_in
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_in

# KEY0, SW0 SW1 SW2 SW3 SW4 SW8 SW9 (JP7 = 2.5V)
set_location_assignment PIN_M23 -to rst_in
set_instance_assignment -name IO_STANDARD "2.5 V" -to rst_in
set_location_assignment PIN_AB28 -to strt_in
set_instance_assignment -name IO_STANDARD "2.5 V" -to strt_in
set_location_assignment PIN_AC28 -to plus_one
set_instance_assignment -name IO_STANDARD "2.5 V" -to plus_one
set_location_assignment PIN_AC27 -to cntrl_in[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to cntrl_in[0]
set_location_assignment PIN_AD27 -to cntrl_in[1]
set_instance_assignment -name IO_STANDARD "2.5 V" -to cntrl_in[1]
set_location_assignment PIN_AB27 -to cntrl_in[2]
set_instance_assignment -name IO_STANDARD "2.5 V" -to cntrl_in[2]
set_location_assignment PIN_AC25 -to ltn_in
set_instance_assignment -name IO_STANDARD "2.5 V" -to ltn_in
set_location_assignment PIN_AB25 -to bln_in
set_instance_assignment -name IO_STANDARD "2.5 V" -to bln_in

# LEDR0 LEDR1 LEDR2, fixed 2.5V
set_location_assignment PIN_G19 -to busy_out[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to busy_out[0]
set_location_assignment PIN_F19 -to busy_out[1]
set_instance_assignment -name IO_STANDARD "2.5 V" -to busy_out[1]
set_location_assignment PIN_E19 -to busy_out[2]
set_instance_assignment -name IO_STANDARD "2.5 V" -to busy_out[2]

# HEX0, seg_out[0..6]
set_location_assignment PIN_G18 -to seg_out[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[0]
set_location_assignment PIN_F22 -to seg_out[1]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[1]
set_location_assignment PIN_E17 -to seg_out[2]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[2]
set_location_assignment PIN_L26 -to seg_out[3]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[3]
set_location_assignment PIN_L25 -to seg_out[4]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[4]
set_location_assignment PIN_J22 -to seg_out[5]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[5]
set_location_assignment PIN_H22 -to seg_out[6]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[6]

# HEX1, seg_out[7..13]
set_location_assignment PIN_M24 -to seg_out[7]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[7]
set_location_assignment PIN_Y22 -to seg_out[8]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[8]
set_location_assignment PIN_W21 -to seg_out[9]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[9]
set_location_assignment PIN_W22 -to seg_out[10]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[10]
set_location_assignment PIN_W25 -to seg_out[11]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[11]
set_location_assignment PIN_U23 -to seg_out[12]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[12]
set_location_assignment PIN_U24 -to seg_out[13]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[13]

# HEX2, seg_out[14..20]
set_location_assignment PIN_AA25 -to seg_out[14]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[14]
set_location_assignment PIN_AA26 -to seg_out[15]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[15]
set_location_assignment PIN_Y25 -to seg_out[16]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[16]
set_location_assignment PIN_W26 -to seg_out[17]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[17]
set_location_assignment PIN_Y26 -to seg_out[18]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[18]
set_location_assignment PIN_W27 -to seg_out[19]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[19]
set_location_assignment PIN_W28 -to seg_out[20]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[20]

# HEX3, seg_out[21..27]
set_location_assignment PIN_V21 -to seg_out[21]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[21]
set_location_assignment PIN_U21 -to seg_out[22]
set_instance_assignment -name IO_STANDARD "2.5 V" -to seg_out[22]
set_location_assignment PIN_AB20 -to seg_out[23]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[23]
set_location_assignment PIN_AA21 -to seg_out[24]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[24]
set_location_assignment PIN_AD24 -to seg_out[25]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[25]
set_location_assignment PIN_AF23 -to seg_out[26]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[26]
set_location_assignment PIN_Y19 -to seg_out[27]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[27]

# HEX4, seg_out[28..34]
set_location_assignment PIN_AB19 -to seg_out[28]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[28]
set_location_assignment PIN_AA19 -to seg_out[29]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[29]
set_location_assignment PIN_AG21 -to seg_out[30]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[30]
set_location_assignment PIN_AH21 -to seg_out[31]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[31]
set_location_assignment PIN_AE19 -to seg_out[32]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[32]
set_location_assignment PIN_AF19 -to seg_out[33]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[33]
set_location_assignment PIN_AE18 -to seg_out[34]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[34]

# HEX5, seg_out[35..41]
set_location_assignment PIN_AD18 -to seg_out[35]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[35]
set_location_assignment PIN_AC18 -to seg_out[36]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[36]
set_location_assignment PIN_AB18 -to seg_out[37]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[37]
set_location_assignment PIN_AH19 -to seg_out[38]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[38]
set_location_assignment PIN_AG19 -to seg_out[39]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[39]
set_location_assignment PIN_AF18 -to seg_out[40]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[40]
set_location_assignment PIN_AH18 -to seg_out[41]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_out[41]

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top